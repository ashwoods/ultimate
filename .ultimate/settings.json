{
  "extensions": {
    "enable": ["voice-live"]
  },
  "modelFamilies": {
    "families": {
      "lead": { "model": "anthropic/claude-opus-5-5", "thinking": "high", "color": "orange" },
      "review": { "model": "anthropic/claude-opus-5-5", "thinking": "high" },
      "fast": { "model": "anthropic/claude-sonnet-5-5" },
      "tiny": { "model": "anthropic/claude-haiku-5-5", "thinking": "low" },
      "design": { "model": "anthropic/claude-opus-5-5" }
    },
    "assign": {
      "preview": "fast"
    }
  },
  "isolates": {
    "worktree": {
      "setup": ["pnpm install --frozen-lockfile --prefer-offline"]
    }
  },
  "lander": {
    "checks": [
      { "command": "pnpm check", "timeout": 120 },
      { "command": "pnpm test --maxWorkers=4", "timeout": 240 },
      { "command": "pnpm test:e2e", "timeout": 240 }
    ],
    "push": "origin"
  }
}
